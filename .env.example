# Copy to .env and fill in. Empty MYSQL_HOST keeps the local SQLite file (backend/data/app.db).
# When MYSQL_HOST is set, the app creates the database if it is missing, creates missing
# tables, and adds missing columns. It does not drop or retype existing columns.

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce_ai

# Optional overrides. Ignored for the database once MYSQL_HOST is set.
# DATABASE_URL=sqlite:///./data/app.db
GATEWAY=fake
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# When GATEWAY=openai, set relay model ids (also used to seed model_profiles on boot):
# PLANNER_MODEL=deepseek-v4.1-flash
# IMAGE_MODEL=gemini-3.1-lite-flash-image
RUN_WORKER=inline
INITIAL_CREDITS=1000
RUN_HOLD_CREDITS=60
STORAGE_DIR=./data/blobs

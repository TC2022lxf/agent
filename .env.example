# Local example only. Copy to .env once; never commit real credentials.
# Root .env is loaded before backend/.env, and neither overrides existing process variables.
GATEWAY=fake
RUN_WORKER=inline
# off disables the automatic in-process worker; it does not start a separate worker service.

# Empty MYSQL_HOST keeps SQLite. Paths below assume starting from backend/.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce_ai
# DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data/blobs
INITIAL_CREDITS=1000
# Per-kind Run budgets are operational settings in the database, not RUN_HOLD_CREDITS.

# Development identity is local only. Review operations/runbook.md before deployment.
AUTH_MODE=dev
COOKIE_SECURE=false
# For a reviewed HTTPS/session deployment: AUTH_MODE=session and COOKIE_SECURE=true.
# Keep ADMIN_NAME empty unless intentionally bootstrapping an admin.
# When set, ADMIN_KEY must be a strong private value: do not use the code's default fallback.
ADMIN_NAME=
ADMIN_KEY=

# Real vendor calls cost money. Configure only with explicit authorization.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
PLANNER_MODEL=
IMAGE_MODEL=
# Existing model profiles are persisted; these values are seed inputs, not a forced reset.

# SKILL_DIR is parsed by Settings, but current container/build_registry does not use the override.
# Current product skills come from repository skills/. Do not rely on this as a working switch.
# SKILL_DIR=../skills
# Canvas MCP has a separate local identity variable; read its source and docs before configuring.
# CANVAS_MCP_USER=
